---
import Link from './Link.astro'

interface NavigationItem {
	href: string
	label: string
}

const navigationItems: NavigationItem[] = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projetos' },
	{ href: '/about', label: 'Sobre' }
]
---

<div class="w-full md:flex md:items-center md:justify-between">
	<div class="flex justify-end p-4 md:hidden">
		<button
			id="menu-btn"
			aria-label="Abrir menu"
			aria-expanded="false"
			aria-controls="menu"
			class="cursor-pointer focus:outline-none"
		>
			<svg
				class="menu-icon pointer-events-none h-6 w-6"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6h16M4 12h16m-7 6h7"></path>
			</svg>

			<svg
				class="menu-icon pointer-events-none hidden h-6 w-6"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<ul
		id="menu"
		class="menu-transition hidden w-full flex-col rounded-3xl bg-zinc-800 p-4 md:flex md:w-auto md:flex-row md:items-center md:gap-4"
		aria-labelledby="menu-btn"
	>
		{
			navigationItems.map((item: NavigationItem) => (
				<li>
					<Link href={item.href} class="block py-2 text-sm hover:text-teal-500 md:py-0">
						{item.label}
					</Link>
				</li>
			))
		}
	</ul>
</div>

<script type="module">
	// Variáveis globais para controlar event listeners
	let currentMenuController = null

	function createMenuController() {
		const menuBtn = document.getElementById('menu-btn')
		const menu = document.getElementById('menu')

		if (!menuBtn || !menu) {
			return null
		}

		const hamburgerIcon = menuBtn.querySelector('svg:first-child')
		const closeIcon = menuBtn.querySelector('svg:last-child')

		// Função unificada para controlar o estado do menu
		function toggleMenu(isOpen = null) {
			const shouldOpen = isOpen ?? menuBtn.getAttribute('aria-expanded') !== 'true'

			menuBtn.setAttribute('aria-expanded', shouldOpen)
			menu.classList.toggle('hidden', !shouldOpen)
			menu.classList.toggle('flex', shouldOpen)

			// Adiciona animação quando o menu abre
			if (shouldOpen) {
				menu.classList.add('menu-fade-in')
				// Remove a classe após a animação
				setTimeout(() => menu.classList.remove('menu-fade-in'), 200)
			}

			if (hamburgerIcon && closeIcon) {
				hamburgerIcon.classList.toggle('hidden', shouldOpen)
				closeIcon.classList.toggle('hidden', !shouldOpen)
			}
		}

		// Event handlers
		const handleMenuClick = () => toggleMenu()

		const handleKeydown = (event) => {
			if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
				toggleMenu(false)
			}
		}

		const handleClickOutside = (event) => {
			if (
				window.innerWidth < 768 &&
				!menuBtn.contains(event.target) &&
				!menu.contains(event.target) &&
				!menu.classList.contains('hidden')
			) {
				toggleMenu(false)
			}
		}

		const handleResize = () => {
			if (window.innerWidth >= 768 && !menu.classList.contains('hidden')) {
				toggleMenu(false)
			}
		}

		const handleBeforeNavigation = () => {
			if (window.innerWidth < 768 && !menu.classList.contains('hidden')) {
				toggleMenu(false)
			}
		}

		// Adicionar event listeners
		menuBtn.addEventListener('click', handleMenuClick)
		document.addEventListener('keydown', handleKeydown)
		document.addEventListener('click', handleClickOutside)
		window.addEventListener('resize', handleResize)
		document.addEventListener('astro:before-preparation', handleBeforeNavigation)

		// Inicializar estado correto
		const isMenuVisible = !menu.classList.contains('hidden')
		if (isMenuVisible && window.innerWidth < 768) {
			toggleMenu(true)
		} else if (window.innerWidth < 768) {
			toggleMenu(false)
		}

		// Retorna funções de controle
		return {
			destroy() {
				menuBtn.removeEventListener('click', handleMenuClick)
				document.removeEventListener('keydown', handleKeydown)
				document.removeEventListener('click', handleClickOutside)
				window.removeEventListener('resize', handleResize)
				document.removeEventListener('astro:before-preparation', handleBeforeNavigation)
			},
			toggleMenu
		}
	}

	function setupMenu() {
		// Cleanup do controller anterior
		if (currentMenuController) {
			currentMenuController.destroy()
		}

		// Criar novo controller
		currentMenuController = createMenuController()
	}

	// Executa a configuração do menu no carregamento inicial da página
	setupMenu()

	// Executa a configuração do menu após cada navegação de página do Astro
	document.addEventListener('astro:page-load', setupMenu)
</script>
