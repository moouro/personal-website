---
import { Icon } from 'astro-icon/components'

export interface Props {
	name: string
	description: string
	url: string
	work?: string
	stack?: string
	date?: string
}

const { name, description, url, work, stack, date } = Astro.props
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="group relative overflow-hidden rounded-xl border border-zinc-700/50 bg-zinc-800/50 p-6 transition-all duration-300 hover:border-zinc-600 hover:bg-zinc-800 hover:shadow-lg hover:shadow-teal-500/10"
>
	<div class="space-y-4">
		<div class="flex items-start justify-between">
			<div class="flex-1">
				<h3
					class="mb-2 text-lg font-semibold text-zinc-100 transition-colors group-hover:text-teal-400"
				>
					{name}
				</h3>
				{
					work && (
						<div class="mb-3 inline-flex items-center gap-2 rounded-full bg-teal-500/10 px-2 py-1 text-xs font-medium text-teal-400">
							<span class="h-2 w-2 animate-pulse rounded-full bg-teal-400" />
							{work}
						</div>
					)
				}
			</div>
			<Icon
				name="arrow"
				size={20}
				class="text-zinc-400 transition-all duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-teal-400"
			/>
		</div>

		<p class="line-clamp-3 text-sm leading-relaxed text-zinc-300">
			{description}
		</p>

		{
			stack && (
				<div class="border-t border-zinc-700/50 pt-2">
					<p class="text-xs font-medium text-zinc-400">{stack}</p>
				</div>
			)
		}

		{
			date && (
				<div class="text-xs text-zinc-500">
					{new Date(date).toLocaleDateString('pt-BR', {
						year: 'numeric',
						month: 'short'
					})}
				</div>
			)
		}
	</div>

	<!-- Subtle gradient overlay on hover -->
	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-br from-teal-500/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
	>
	</div>
</a>
