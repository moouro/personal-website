---
export interface LinkProps extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, class: className, ...props } = Astro.props

const path = Astro.url.pathname.replace(/\/$/, '')

const isExternal = href?.startsWith('http') || href?.startsWith('mailto:')

const isHome = href === '/' && path === ''

const isOtherPages =
	typeof href === 'string' && href.length > 1
		? path.substring(1).startsWith(href.substring(1))
		: false

const isActive =
	href === '/' ? path === '' || path === '/' : path === href || path.startsWith(href + '/')
---

<!-- DO NOT FORMAT. IT ADDS AN EXTRA SPACE ON RENDERED CONTENT. -->
<a
	href={href}
	aria-current={isActive ? 'page' : undefined}
	class:list={[className, isActive ? 'text-teal-500' : 'border-b-0']}
	{...props}><slot /></a
>
