---
import Layout from '../layouts/Layout.astro'
import Project from '@/components/Project.astro'
import projectData from '@/data/projects.json'
import { ClientRouter } from 'astro:transitions'
import Menu from '@/components/Menu.astro'

// Ordenar projetos por data (mais recentes primeiro)
const sortedProjects = [...projectData].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
)
---

<Layout title="Projetos - mouro.dev">
	<ClientRouter />
	<div class="min-h-screen bg-zinc-900">
		<!-- Navigation -->
		<nav class="container mx-auto mt-10 max-w-3xl px-4">
			<div class="space-y-6">
				<Menu />
			</div>
		</nav>

		<!-- Main Content -->
		<main class="container mx-auto max-w-3xl px-4 pb-16">
			<!-- Page Header -->
			<header class="mb-16">
				<h1 class="mb-6 text-4xl font-bold md:text-5xl">Projetos</h1>
				<div class="space-y-4 text-lg leading-relaxed text-zinc-300">
					<p>
						Bem-vindo ao meu portfólio! Aqui você encontrará os projetos que desenvolvi, cada um
						refletindo minha dedicação e atenção aos detalhes.
					</p>
					<p>
						Sempre focando em entregar experiências de usuário excepcionais e aplicar as melhores
						práticas de desenvolvimento.
					</p>
				</div>
			</header>

			<!-- Projects Grid -->
			<section>
				<div class="grid gap-8 md:grid-cols-2">
					{
						sortedProjects.map((project) => (
							<Project
								name={project.name}
								description={project.description}
								url={project.url}
								stack={project.stack}
								work={project.work}
								date={project.date}
							/>
						))
					}
				</div>

				<!-- Coming Soon -->
				<div class="mt-16 text-center">
					<p class="text-zinc-400">Mais projetos interessantes estão chegando...</p>
				</div>
			</section>
		</main>

		<!-- Simple Footer -->
		<footer class="container mx-auto max-w-3xl px-4 py-8 text-center text-sm text-zinc-400">
			<p>© 2025 Mouro. Feito com ❤️ usando Astro.</p>
		</footer>
	</div>
</Layout>
